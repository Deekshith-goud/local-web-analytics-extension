{
  "name": "local-browse-analytics",
  "displayName": "Local Browse Analytics",
  "version": "1.0.0",
  "description": "Privacy-first, local-only browser analytics extension.",
  "author": "Deekshith-goud",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "bun run build && node scripts/package-extension.js && plasmo package",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "dexie": "^4.4.2",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.268",
    "@types/node": "20.12.7",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@typescript-eslint/eslint-plugin": "7.7.1",
    "@typescript-eslint/parser": "7.7.1",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-no-unsanitized": "4.0.2",
    "eslint-plugin-react": "7.34.1",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-security": "3.0.0",
    "postcss": "8.4.38",
    "prettier": "3.2.5",
    "tailwindcss": "3.4.3",
    "typescript": "5.4.5"
  },
  "manifest": {
    "host_permissions": [],
    "permissions": [
      "storage",
      "tabs",
      "idle",
      "windows",
      "favicon",
      "alarms",
      "notifications",
      "offscreen"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
    }
  }
}
